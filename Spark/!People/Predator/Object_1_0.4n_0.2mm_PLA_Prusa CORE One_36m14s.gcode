; YII=
; thumbnail end
; THUMBNAIL_BLOCK_END

; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.42mm
; first layer extrusion width = 0.50mm

; EXECUTABLE_BLOCK_START
M486 S0
M486 AObject_1_id_0_copy_0
M486 S-1
M73 P0 R36
M201 X10000 Y10000 Z400 E5000
M203 X350 Y350 Z12 E100
M204 P7000 R2500 T7000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X10.00 Y10.00 Z2.00 E10.00 ; sets the jerk limits, mm/sec
M205 J0.010
;TYPE:Custom
; --- Printer Initialization and Checks ---

M17 ; enable steppers
M862.1 P0.4 A0 F0 ; nozzle check
M862.3 P "COREONE" ; printer model check
M862.5 P2 ; g-code level check
M862.6 P"Input shaper" ; FW feature check
M115 U6.3.0+10073

; --- Print Area and Coordinate System ---

M555 X111.125 Y97.6881 W32 H27.7507 ; define print area

G90 ; use absolute coordinates
M83 ; extruder in relative mode

; --- Preparation ---

 
; just set the selected bed temp otherwise
M140 S55 ; set bed temp


M109 R170 ; wait for temp

M84 E ; turn off E motor

G28 ; home all axes without mesh bed leveling


; -- Chamber Temperature Control --

M141 S20 ; set nominal chamber temp


M106 S70
G0 Z40 F10000
M104 T0 S100
M190 R55 ; wait for bed temp
M107

G29 G ; absorb heat

M109 R170 ; wait for MBL temp

M302 S160 ; lower cold extrusion limit to 160C


G1 E-2 F2400 ; retraction
M73 P12 R31


M84 E ; turn off E motor

; --- Mesh Bed Leveling (MBL) ---

G29 P9 X208 Y-2.5 W32 H4 ; limited MBL
M84 E ; turn off E motor

G29 P1 ; invalidate MBL and probe print area
G29 P1 X150 Y0 W100 H20 C ; probe near purge area
G29 P3.2 ; MBL interpolation
G29 P3.13 ; MBL extrapolation outside probe area
G29 A ; activate MBL

; --- Preparation for Purge Line ---

M104 S220
G0 X249 Y-2.5 Z15 F4800 ; move away and ready for the purge
M109 S220

G92 E0 ; reset extruder position
M569 S0 E ; set spreadcycle mode for extruder

; --- Extrude Purge Line ---

G92 E0 ; reset extruder position
G1 E2 F2400 ; deretraction after the initial one
G0 E5 X235 Z0.2 F500 ; purge
G0 X225 E4 F500 ; purge
G0 X215 E4 F650 ; purge
G0 X205 E4 F800 ; purge
G0 X202 Z0.05 F8000 ; wipe, close to bed
G0 X199 Z0.2 F8000 ; wipe, quickly away from bed

G92 E0 ; reset extruder position
M221 S100 ; set flow to 100%
G90
G21
M83 ; use relative distances for extrusion
; Filament gcode
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
G92 E0.0
;0.2


G1 E-.7 F2700
;AFTER_LAYER_CHANGE
;0.2
;_SET_FAN_SPEED_CHANGING_LAYER
M204 P500
; printing object Object_1 id:0 copy 0
M204 T500
